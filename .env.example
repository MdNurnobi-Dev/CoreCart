# =================================================================
# TECHSTORE PRODUCTION ENVIRONMENT CONFIGURATION
# Rename this file to `.env` and fill in your actual credentials
# =================================================================

# 1. APPLICATION ENVIRONMENT
NODE_ENV="production"
PORT=3000
APP_URL="http://localhost:3000"

# 2. SECURITY & AUTHENTICATION
JWT_SECRET="your_jwt_secret_key_here_make_it_long_and_secure"

# 3. DATABASE CONFIGURATION (Supports Turso SQLite & Neon PostgreSQL)
# Define which engine to use: "turso" or "postgres"
DATABASE_TYPE="turso"

# -- Turso (Cloud SQLite) Credentials --
TURSO_DATABASE_URL="libsql://your-turso-database.turso.io"
TURSO_AUTH_TOKEN="your_turso_jwt_auth_token_here"

# -- Neon (PostgreSQL) Credentials --
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# 4. STORAGE CONFIGURATION (Supports Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_key_here"
R2_BUCKET_NAME="your_r2_bucket_name"
R2_PUBLIC_URL="https://your-custom-r2-domain.com"

# 5. LIVE CHAT & NOTIFICATIONS (Telegram / Firebase)
# -- Telegram Bot --
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789"
TELEGRAM_CHAT_ID="-1001234567890"

# -- Firebase (Optional for Realtime Sync) --
# Usually provided via the Admin UI, but can be added here if needed for server scripts
FIREBASE_PROJECT_ID="your-firebase-project-id"

# 6. PAYMENT GATEWAYS (If applicable in server)
# STRIPE_SECRET_KEY="sk_test_..."
# SSLCOMMERZ_STORE_ID="your_store_id"
# SSLCOMMERZ_STORE_PASSWORD="your_store_password"

# 7. AI INTEGRATIONS (Optional)
GEMINI_API_KEY="your_google_gemini_api_key_here"
